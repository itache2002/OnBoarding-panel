

# ---- Build stage -------------------------------------------------------------
# Has recent Flutter + Dart (>=3.6)
FROM ghcr.io/cirruslabs/flutter:stable AS build
# (you can pin to a known tag later, e.g. 3.27.x, once confirmed)

WORKDIR /app
COPY pubspec.* ./
RUN flutter pub get
COPY . .
RUN flutter config --enable-web
RUN flutter build web --release

# ---- Runtime stage (unchanged) ----------------------------------------------
FROM nginx:1.27-alpine

RUN rm -rf /usr/share/nginx/html/* \
 && mkdir -p /var/cache/nginx/{client_temp,proxy_temp,fastcgi_temp,uwsgi_temp,scgi_temp} /var/run/nginx \
 && chown -R nginx:nginx /var/cache/nginx /var/run/nginx /usr/share/nginx/html

# keep your nginx.conf or the inline write step you had
COPY --from=build /app/build/web /usr/share/nginx/html

# Option A: root on 80 (simplest)
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
